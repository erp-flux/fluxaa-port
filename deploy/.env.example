# =============================================================================================
# FLUXAA Port — configuration d'une installation (modèle, sans aucun secret réel).
#
# Copier ce fichier en deploy/.env (cp .env.example .env && chmod 600 .env), puis remplir toutes
# les valeurs vides et remplacer les valeurs d'exemple. Docker Compose lit ce fichier pour tous
# les services. Ne jamais versionner deploy/.env ni le ranger avec les sauvegardes de données :
# en garder une copie protégée à part (voir docs/DEPLOIEMENT.md, « Clés et secrets »).
#
# Syntaxe : NOM=valeur, sans espace autour de « = ». Pas de caractère « $ » dans les valeurs.
# Une valeur qui contient des espaces s'écrit entre guillemets doubles. Une variable inutile se
# commente (#) plutôt que de rester vide : une valeur vide n'est pas une valeur par défaut.
# =============================================================================================

# ---------------------------------------------------------------------------------------------
# Nom de domaine et adresses
# ---------------------------------------------------------------------------------------------
# Nom de domaine de l'installation. L'enregistrement DNS A (et AAAA en IPv6) doit pointer vers le
# serveur : Caddy obtient le certificat HTTPS pour ce nom.
DOMAIN=registre.example.org
# Noms d'hôte acceptés par Django, séparés par des virgules. Doit contenir DOMAIN.
DJANGO_ALLOWED_HOSTS=registre.example.org
# Origines de confiance pour la protection CSRF : « https:// » suivi de DOMAIN.
DJANGO_CSRF_TRUSTED_ORIGINS=https://registre.example.org
# Adresse publique utilisée dans les liens envoyés par e-mail et SMS (sans « / » final).
FLUXAA_SITE_URL=https://registre.example.org

# ---------------------------------------------------------------------------------------------
# Clés applicatives — générées une fois, copie de secours conservée hors du serveur
# ---------------------------------------------------------------------------------------------
# Clé Django : sessions, jetons CSRF, liens de réinitialisation de mot de passe. La changer
# déconnecte tous les utilisateurs, sans autre conséquence.
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Clé de scellement (HMAC-SHA256) des signatures, jalons, autorisations, horodatages et exports ;
# elle chiffre aussi les secrets de double authentification (TOTP). NE JAMAIS LA CHANGER : les
# sceaux existants deviendraient invérifiables et chaque utilisateur devrait réenrôler son
# application d'authentification.
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
FLUXAA_SIGNING_KEY=
# Clés Fernet du domaine de sûreté N4, distinctes de toutes les autres clés. Liste séparée par
# des virgules, la plus récente en premier : la première chiffre, toutes déchiffrent.
# Rotation : ajouter la nouvelle clé EN TÊTE et garder les anciennes après elle, sans jamais en
# retirer (les données chiffrées avec une clé retirée deviendraient illisibles).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Équivalent si le module cryptography n'est pas installé sur la machine :
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FLUXAA_N4_KEYS=

# ---------------------------------------------------------------------------------------------
# PostgreSQL — mots de passe des rôles
# ---------------------------------------------------------------------------------------------
# Lus au PREMIER démarrage de la base (volume pgdata vide) pour créer les rôles : les modifier
# ensuite ici ne change pas les rôles (procédure dans docs/DEPLOIEMENT.md).
# À générer en hexadécimal, sans caractère à encoder dans les URL de la section suivante :
#   python3 -c "import secrets; print(secrets.token_hex(24))"
# Superutilisateur « postgres » : initialisation et restauration seulement.
POSTGRES_PASSWORD=
# Rôle propriétaire fluxaa_owner : migrations, attribution des droits, sauvegardes.
FLUXAA_OWNER_PASSWORD=
# Rôle d'exécution fluxaa_app de la base principale (aucun droit de suppression sur le registre).
FLUXAA_APP_PASSWORD=
# Rôle d'exécution fluxaa_secure_app de la base N4 (n'accède qu'à fluxaa_secure).
FLUXAA_SECURE_APP_PASSWORD=

# ---------------------------------------------------------------------------------------------
# PostgreSQL — connexions de l'application
# ---------------------------------------------------------------------------------------------
# Remplacer chaque MOT_DE_PASSE_… par le mot de passe correspondant de la section précédente
# (la concordance est contrôlée au démarrage du conteneur web). « db » est le nom du service
# PostgreSQL dans docker-compose.yml.
# Base principale, rôle d'exécution : utilisé en permanence par le service web et le planificateur.
DATABASE_URL=postgres://fluxaa_app:MOT_DE_PASSE_APP@db:5432/fluxaa
# Base principale, rôle propriétaire : migrations au démarrage et sauvegardes.
DATABASE_OWNER_URL=postgres://fluxaa_owner:MOT_DE_PASSE_OWNER@db:5432/fluxaa
# Base de sûreté N4, rôle d'exécution dédié.
SECURE_DATABASE_URL=postgres://fluxaa_secure_app:MOT_DE_PASSE_SECURE_APP@db:5432/fluxaa_secure
# Base de sûreté N4, rôle propriétaire.
SECURE_DATABASE_OWNER_URL=postgres://fluxaa_owner:MOT_DE_PASSE_OWNER@db:5432/fluxaa_secure

# ---------------------------------------------------------------------------------------------
# Horodatage (CDC ENF-4.2, point ouvert O04)
# ---------------------------------------------------------------------------------------------
# « local » : horloge du serveur, scellée avec FLUXAA_SIGNING_KEY (le serveur doit être
# synchronisé par NTP). « rfc3161 » : autorité d'horodatage qualifiée, une fois le prestataire
# choisi ; tant qu'aucun client n'est raccordé, l'application revient au scellement local et
# l'écrit dans son journal.
FLUXAA_TIMESTAMP_PROVIDER=local
# Adresse de l'autorité d'horodatage (uniquement avec « rfc3161 »).
# FLUXAA_TSA_URL=https://tsa.example.org

# ---------------------------------------------------------------------------------------------
# Courrier électronique : notifications, résumés quotidiens, alertes
# ---------------------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
# 587 avec STARTTLS (EMAIL_USE_TLS=1).
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# Expéditeur. Son domaine doit être autorisé à émettre par EMAIL_HOST (SPF, DKIM).
DEFAULT_FROM_EMAIL="FLUXAA Port <no-reply@registre.example.org>"

# ---------------------------------------------------------------------------------------------
# SMS : escalades uniquement (CDC EF-18)
# ---------------------------------------------------------------------------------------------
# console : les SMS sont seulement écrits dans le journal du conteneur (aucun envoi) ;
# webhook : envoi par la passerelle ci-dessous ; disabled : aucun SMS.
FLUXAA_SMS_BACKEND=console
# Passerelle SMS : requête POST JSON avec l'en-tête « Authorization: Bearer <jeton> ».
FLUXAA_SMS_WEBHOOK_URL=
FLUXAA_SMS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------------------------
# Authentification forte (CDC ENF-3.1)
# ---------------------------------------------------------------------------------------------
# 1 : double authentification (TOTP) obligatoire pour les rôles CAP, APO et SUR.
# Ne pas désactiver en production.
FLUXAA_MFA_ENFORCED=1

# ---------------------------------------------------------------------------------------------
# Assistance IA optionnelle (CDC EF-17) — ne reçoit jamais de données N4
# ---------------------------------------------------------------------------------------------
# Active uniquement si les TROIS conditions sont réunies : FLUXAA_AI_ENABLED=1, ANTHROPIC_API_KEY
# renseignée, et FLUXAA_AI_PROVIDER_AGREEMENT = référence de la clause contractuelle conclue avec
# le fournisseur (EF-17 : aucun envoi de données identifiantes à un tiers sans clause explicite).
# Chaque port doit en plus l'activer dans le paramétrage (case « assistance IA activée » et
# référence de l'accord du port), ce que seul l'exploitant peut faire. Les textes et documents
# soumis sont alors envoyés à l'API d'Anthropic, hors de l'infrastructure du port.
FLUXAA_AI_ENABLED=0
ANTHROPIC_API_KEY=
FLUXAA_AI_PROVIDER_AGREEMENT=
# Modèle à utiliser ; laisser commenté pour garder la valeur par défaut de l'application.
# FLUXAA_AI_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------------------------------------
# Tableau AIS (facultatif) — DEPLOIEMENT.md §15
# ---------------------------------------------------------------------------------------------
# Clé du flux aisstream.io, utilisée seulement par le service « ais » (manage.py ais_listen
# --aisstream). Un récepteur local (NMEA sur UDP/TCP) ou un fournisseur qui publie sur l'API
# (POST /api/v1/ais/positions/) n'en a pas besoin.
FLUXAA_AISSTREAM_KEY=
# Port écouté par le service « ais » du docker-compose (profil ais) : SLFNA ou TGLFW.
# AIS_PORT=SLFNA

# ---------------------------------------------------------------------------------------------
# Journalisation
# ---------------------------------------------------------------------------------------------
# DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------------------------
# Sauvegardes (scripts/backup.sh)
# ---------------------------------------------------------------------------------------------
# Dossier de l'HÔTE monté sur /backups dans le conteneur web : chemin absolu, ou relatif au
# dossier deploy/. De préférence sur un autre disque que les volumes Docker. Il doit appartenir à
# l'UID/GID 10001 (utilisateur du conteneur) : sudo chown 10001:10001 <dossier>
BACKUP_HOST_DIR=./backups
# Durée de conservation des sauvegardes locales, en jours.
BACKUP_RETENTION_DAYS=30

# ---------------------------------------------------------------------------------------------
# Réglages facultatifs (valeurs par défaut indiquées ; décommenter pour modifier)
# ---------------------------------------------------------------------------------------------
# Ports dont le catalogue de référence est chargé au démarrage, séparés par des virgules
# (défaut : tous les ports connus, SLFNA Freetown et TGLFW Lomé). Utile pour une instance nationale.
# FLUXAA_BOOTSTRAP_PORTS=TGLFW
# Taille maximale d'une pièce déposée, en Mio. Garder une marge sous la limite de 30 Mo du Caddyfile.
# FLUXAA_MAX_UPLOAD_MB=25
# Durée d'une session web, en secondes (12 h).
# SESSION_COOKIE_AGE=43200
# Durée pendant laquelle une vérification TOTP vaut authentification forte pour décider, en s (8 h).
# FLUXAA_MFA_STEPUP_SECONDS=28800
# Délai au-delà duquel une saisie hors ligne synchronisée est marquée « saisie différée », en s.
# FLUXAA_DEFERRED_THRESHOLD_SECONDS=120
# Une saisie en ligne déclarée pour une heure antérieure de plus de ce délai à son enregistrement est elle aussi
# marquée « saisie différée », en s (30 min).
# FLUXAA_LATE_ENTRY_SECONDS=1800
# Quota de requêtes de l'API par utilisateur.
# API_THROTTLE_USER=2000/hour
# Durée de vie des connexions à la base, en secondes.
# DB_CONN_MAX_AGE=60
# Durée HSTS envoyée par Django, en secondes.
# DJANGO_HSTS_SECONDS=31536000
# Politique de sécurité du contenu (en-tête Content-Security-Policy) des pages HTML. La valeur par défaut,
# définie dans fluxaa/settings.py, n'autorise que les scripts et ressources servis par la plateforme : laisser
# cette variable commentée sauf besoin précis (valeur complète entre guillemets doubles).
# FLUXAA_CONTENT_SECURITY_POLICY=
# Mode débogage : à ne jamais activer ici (le conteneur web refuse alors de démarrer).
# DJANGO_DEBUG=0
