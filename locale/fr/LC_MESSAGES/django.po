msgid "Decision: <b>%(d)s</b>"
msgstr "Décision : <b>%(d)s</b>"

#, python-format
msgid "Conditions: %(c)s"
msgstr "Conditions : %(c)s"

#, python-format
msgid "Reason: %(reason)s"
msgstr "Motif : %(reason)s"

msgid ""
"Reason restricted to the agency, the owner and the instructing service."
msgstr "Motif réservé à l'agence, à l'armateur et au service instructeur."

msgid "valid until"
msgstr "valable jusqu'au"

msgid "verification code"
msgstr "code de vérification"

msgid "Berth or area assigned"
msgstr "Poste ou zone attribué"

msgid "Effective from"
msgstr "En vigueur à partir du"

msgid "Valid until"
msgstr "Valable jusqu'au"

#, python-format
msgid "default: %(h)s h"
msgstr "par défaut : %(h)s h"

