msgid ""
"%(v)s is still heard moored in the port waters %(h).0f h after the departure"
" recorded on call %(r)s."
msgstr ""
"%(v)s est toujours entendu amarré dans les eaux du port %(h).0f h après "
"l'appareillage enregistré sur l'escale %(r)s."

