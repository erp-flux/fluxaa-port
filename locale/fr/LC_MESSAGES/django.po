msgid "Security matters go to the security space."
msgstr "Les questions de sûreté vont dans l'espace sûreté."

msgid "A bilateral thread involves exactly two parties."
msgstr "Un fil bilatéral réunit exactement deux parties."

msgid "Choose at least one other party."
msgstr "Choisissez au moins une autre partie."

msgid "Subject and message are required."
msgstr "L'objet et le message sont requis."

msgid "You are not a participant of this thread."
msgstr "Vous ne participez pas à ce fil."

msgid "The message is empty."
msgstr "Le message est vide."

msgid "The attachment belongs to another call."
msgstr "La pièce jointe appartient à une autre escale."

msgid "Unknown subject of dispute."
msgstr "Objet de contestation inconnu."

msgid "The disputed item does not belong to this call."
msgstr "L'élément contesté n'appartient pas à cette escale."

msgid "A dispute states its subject and grounds."
msgstr "Une contestation énonce son objet et ses motifs."

msgid "This dispute is closed."
msgstr "Cette contestation est close."

msgid "The response is empty."
msgstr "La réponse est vide."

msgid "This dispute is addressed to another party."
msgstr "Cette contestation est adressée à une autre partie."

msgid "This dispute is already closed."
msgstr "Cette contestation est déjà close."

msgid "State how the dispute ends."
msgstr "Indiquez comment la contestation se termine."

msgid ""
"The harbour master records a closure without agreement only: an agreement "
"belongs to the parties."
msgstr ""
"La capitainerie n'enregistre qu'une clôture sans accord : l'accord "
"appartient aux parties."

#, python-format
msgid "Unknown document type: %(code)s"
msgstr "Type de document inconnu : %(code)s"

msgid "This document is generated from the registry, never uploaded (EF-7.3)."
msgstr ""
"Ce document est généré à partir du registre, jamais téléversé (EF-7.3)."

msgid "N4 documents are filed in the security space only."
msgstr "Les documents N4 sont déposés uniquement dans l'espace sûreté."

msgid "A bilateral (N3) document names its counterpart."
msgstr "Un document bilatéral (N3) désigne sa contrepartie."

#, python-format
msgid "File type not accepted (%(ext)s)."
msgstr "Type de fichier non accepté (%(ext)s)."

#, python-format
msgid "File too large (max %(mb)s MB)."
msgstr "Fichier trop volumineux (%(mb)s Mo au maximum)."

msgid "The file is empty."
msgstr "Le fichier est vide."

msgid "A new version concerns the same call and document type."
msgstr ""
"Une nouvelle version concerne la même escale et le même type de document."

msgid "Only an issued or signed document can be replaced."
msgstr "Seul un document émis ou signé peut être remplacé."

msgid "Only the issuer publishes a new version."
msgstr "Seul l'émetteur publie une nouvelle version."

msgid "This task belongs to another call."
msgstr "Cette tâche appartient à une autre escale."

msgid "This task is already closed."
msgstr "Cette tâche est déjà close."

#, python-format
msgid "Task %(task)s expects another document: %(type)s."
msgstr "La tâche %(task)s attend un autre document : %(type)s."

#, python-format
msgid "Task %(task)s is not completed by providing a document."
msgstr "La tâche %(task)s ne se termine pas par la fourniture d'un document."

msgid "Only an issued document awaiting signatures can be signed."
msgstr "Seul un document émis en attente de signatures peut être signé."

msgid "Invalid signature image."
msgstr "Image de signature invalide."

msgid "Only the issuer cancels a document."
msgstr "Seul l'émetteur annule un document."

msgid "This document can no longer be cancelled."
msgstr "Ce document ne peut plus être annulé."

msgid "Not found."
msgstr "Introuvable."

msgid "This decision requires a recent two-factor authentication."
msgstr "Cette décision exige une double authentification récente."

msgid "Unknown form."
msgstr "Formulaire inconnu."

msgid "This form is not generated by your role."
msgstr "Ce formulaire n'est pas produit par votre rôle."

msgid "This form does not apply to the operations of this call."
msgstr "Ce formulaire ne s'applique pas aux opérations de cette escale."

#, python-format
msgid "Refused: “%(transition)s” is not possible yet."
msgstr "Refus : « %(transition)s » n'est pas encore possible."

#, python-format
msgid ""
"Missing task %(code)s “%(title)s” — responsible: %(roles)s — expected "
"action: %(action)s."
msgstr ""
"Tâche manquante %(code)s « %(title)s » — responsable : %(roles)s — action "
"attendue : %(action)s."

#, python-format
msgid "“%(f)s” must be a number."
msgstr "« %(f)s » doit être un nombre."

msgid "Unknown measurement kind."
msgstr "Nature de mesure inconnue."

msgid "Unknown party."
msgstr "Partie inconnue."

msgid "This value is entered by its owner only (single emitter)."
msgstr "Cette valeur est saisie par son seul titulaire (émetteur unique)."

msgid "A quantity is a positive number."
msgstr "Une quantité est un nombre positif."

msgid "A correction concerns a value of the same party."
msgstr "Une correction porte sur une valeur de la même partie."

msgid ""
"The shore figure is entered by the terminal that speaks for the shore side "
"on this call."
msgstr ""
"La quantité terre est saisie par le terminal qui parle pour le côté terre "
"sur cette escale."

#, python-format
msgid "Unknown milestone type: %(code)s"
msgstr "Type de jalon inconnu : %(code)s"

msgid "This milestone is recorded by the platform."
msgstr "Ce jalon est enregistré par la plateforme."

#, python-format
msgid "“%(m)s” is recorded by %(role)s only (single emitter)."
msgstr "« %(m)s » est enregistré par %(role)s uniquement (émetteur unique)."

msgid ""
"Another organisation speaks for the shore side on this call: the agency or "
"the harbour master designates it in the parties of the call."
msgstr ""
"Une autre organisation parle pour le côté terre sur cette escale : l'agence "
"ou la capitainerie la désigne dans les parties de l'escale."

msgid "A milestone cannot be declared in the future."
msgstr "Un jalon ne peut pas être déclaré dans le futur."

msgid "An interruption requires a cause from the closed list."
msgstr "Une interruption exige une cause de la liste fermée."

#, python-format
msgid "The cause “%(c)s” requires a reason."
msgstr "La cause « %(c)s » exige un motif."

msgid "Indicate the interruption that ends."
msgstr "Indiquez l'interruption qui prend fin."

msgid "This interruption is already closed."
msgstr "Cette interruption est déjà close."

msgid "The end cannot precede the start."
msgstr "La fin ne peut pas précéder le début."

msgid ""
"The end of an interruption is recorded by the party that recorded its start."
msgstr ""
"La fin d'une interruption est enregistrée par la partie qui en a enregistré "
"le début."

msgid "A rectification concerns a milestone of the same type."
msgstr "Une rectification porte sur un jalon du même type."

msgid "Only the emitter of a milestone can rectify it."
msgstr "Seul l'émetteur d'un jalon peut le rectifier."

msgid "A rectification requires a reason."
msgstr "Une rectification exige un motif."

msgid "A contest states its grounds."
msgstr "Une contestation énonce ses motifs."

msgid "Your role has already countersigned this milestone."
msgstr "Votre rôle a déjà contresigné ce jalon."

msgid "Your role has already contested this milestone."
msgstr "Votre rôle a déjà contesté ce jalon."

msgid "This milestone is not corroborated by AIS."
msgstr "Ce jalon n'est pas corroboré par l'AIS."

msgid "The statement of facts is produced by the agency."
msgstr "Le rapport des faits est produit par l'agence."

msgid "The statement of facts is produced after the end of operations."
msgstr "Le rapport des faits est produit après la fin des opérations."

#, python-format
msgid "Unknown request type: %(code)s"
msgstr "Type de demande inconnu : %(code)s"

#, python-format
msgid "Field “%(f)s” is required."
msgstr "Le champ « %(f)s » est obligatoire."

#, python-format
msgid "Field “%(f)s” must be a number."
msgstr "Le champ « %(f)s » doit être un nombre."

#, python-format
msgid "Field “%(f)s” must be a date and time."
msgstr "Le champ « %(f)s » doit être une date et une heure."

#, python-format
msgid "Invalid choice for “%(f)s”."
msgstr "Choix invalide pour « %(f)s »."

#, python-format
msgid "A request in state “%(a)s” cannot become “%(b)s”."
msgstr "Une demande à l'état « %(a)s » ne peut pas passer à « %(b)s »."

msgid "Choose the provider among the organisations taking part in the call."
msgstr ""
"Choisissez le prestataire parmi les organisations qui participent à "
"l'escale."

msgid ""
"Several organisations can carry out this service on the call: choose the one"
" who will."
msgstr ""
"Plusieurs organisations peuvent exécuter ce service sur l'escale : "
"choisissez celle qui le fera."

msgid "Only the requesting party submits the request."
msgstr "Seule la partie demanderesse soumet la demande."

msgid "The requesting role cannot review its own request (rule 2)."
msgstr "Le rôle demandeur ne peut pas instruire sa propre demande (règle 2)."

msgid "Unknown decision."
msgstr "Décision inconnue."

msgid ""
"The requesting role or person can never decide on its own request (rule 2)."
msgstr ""
"Le rôle ou la personne qui demande ne peut jamais décider de sa propre "
"demande (règle 2)."

msgid "This request is not awaiting a decision."
msgstr "Cette demande n'attend pas de décision."

msgid "A refusal or a request for information states its reason."
msgstr "Un refus ou une demande de complément énonce son motif."

msgid "An approval with conditions states the conditions."
msgstr "Une approbation sous conditions énonce les conditions."

msgid "Select the berth or area assigned."
msgstr "Choisissez le poste ou la zone attribué."

msgid ""
"The berth assigned does not match the operating area of the call, nor of a "
"planned stage."
msgstr ""
"Le poste attribué ne correspond ni à la zone d'exploitation de l'escale, ni "
"à celle d'une étape planifiée."

msgid "This request awaits the decision of the competent authority."
msgstr "Cette demande attend la décision de l'autorité compétente."

msgid "This request is not carried out by a provider."
msgstr "Cette demande n'est pas exécutée par un prestataire."

msgid "Only the requesting party names the provider."
msgstr "Seule la partie demanderesse désigne le prestataire."

msgid "The provider of this order can no longer be chosen."
msgstr "Le prestataire de cette commande ne peut plus être choisi."

msgid "This service order is carried out by another provider."
msgstr "Cette commande de service est exécutée par un autre prestataire."

msgid "Only the requesting party cancels its request."
msgstr "Seule la partie demanderesse annule sa demande."

msgid "Only the issuing authority cancels an authorization."
msgstr "Seule l'autorité émettrice annule une autorisation."

msgid "Your role on this call does not allow this action."
msgstr "Votre rôle sur cette escale ne permet pas cette action."

msgid "Select at least one operation model for the stage."
msgstr "Choisissez au moins un modèle d'opération pour l'étape."

msgid "The stages of a call are planned by the agency or the harbour master."
msgstr ""
"Les étapes d'une escale sont planifiées par l'agence ou la capitainerie."

msgid "The call is closed or the vessel has departed: no further stage."
msgstr "L'escale est close ou le navire a appareillé : plus d'étape possible."

msgid "Unknown operating area."
msgstr "Zone d'exploitation inconnue."

msgid "The end of the window must follow its start."
msgstr "La fin de la fenêtre doit suivre son début."

msgid "Only a planned stage can be cancelled."
msgstr "Seule une étape planifiée peut être annulée."

msgid ""
"No next stage is planned for this call: the agency or the harbour master "
"plans it first (overview, « Stages of the call »)."
msgstr ""
"Aucune étape suivante n'est planifiée pour cette escale : l'agence ou la "
"capitainerie la planifie d'abord (aperçu, « Étapes de l'escale »)."

msgid "(product not stated)"
msgstr "(produit non renseigné)"

msgid "(no cause)"
msgstr "(sans cause)"

