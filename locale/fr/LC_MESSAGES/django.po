msgstr "L'assistant n'a pas pu être joint : %(e)s"

#, python-format
msgid "The assistant returned no usable answer (%(r)s)."
msgstr "L'assistant n'a pas rendu de réponse exploitable (%(r)s)."

msgid "The assistant returned an unreadable answer."
msgstr "L'assistant a rendu une réponse illisible."

msgid "Extraction from a document"
msgstr "Extraction depuis un document"

msgid "Consistency review of the call"
msgstr "Revue de cohérence de l'escale"

msgid "Summary of an exchange"
msgstr "Résumé d'un échange"

msgid "Draft remarks for the statement of facts"
msgstr "Projet de remarques pour le rapport des faits"

