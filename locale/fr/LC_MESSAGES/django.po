msgid "[FLUXAA Port] Two-factor authentication changed on your account"
msgstr "[FLUXAA Port] Double authentification modifiée sur votre compte"

#, python-format
msgid ""
"A new authenticator application has just been registered for your account "
"(%(email)s). If you did not do it, contact your port administrator at once: "
"your password is known to someone else."
msgstr ""
"Une nouvelle application d'authentification vient d'être enregistrée pour "
"votre compte (%(email)s). Si ce n'est pas vous, contactez immédiatement "
"l'administrateur de votre port : votre mot de passe est connu d'un tiers."

msgid ""
"Too many incorrect codes. Wait up to fifteen minutes before trying again."
msgstr ""
"Trop de codes incorrects. Attendez jusqu'à quinze minutes avant de "
"réessayer."

msgid "The code of your current authenticator application is not valid."
msgstr ""
"Le code de votre application d'authentification actuelle n'est pas valide."

msgid "Two-factor authentication is active."
msgstr "La double authentification est active."

msgid "The code is not valid. Check the time of your phone and try again."
msgstr ""
"Le code n'est pas valide. Vérifiez l'heure de votre téléphone et réessayez."

msgid "The code is not valid."
msgstr "Le code n'est pas valide."

msgid "Notification preference saved."
msgstr "Préférence de notification enregistrée."

msgid "Copy this token now: it will not be shown again."
msgstr "Copiez ce jeton maintenant : il ne sera plus affiché."

msgid "API token revoked."
msgstr "Jeton d'API révoqué."

msgid "published version"
msgstr "version publiée"

msgid "Create a draft version (copy of the published one) to edit"
msgstr "Créer une version brouillon (copie de la version publiée) à modifier"

